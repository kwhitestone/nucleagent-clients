{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NucleAgent",
  "version": "0.1.0",
  "identifier": "top.whitestone.nucleagent",
  "build": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "main",
      "create": false,
      "title": "NucleAgent",
      "url": "https://nucleagent.whitestone.top",
      "width": 1280,
      "height": 800,
      "minWidth": 640,
      "minHeight": 480,
      "resizable": true
    }],
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; frame-src https://whitestone.top https://*.whitestone.top; connect-src https://whitestone.top https://*.whitestone.top wss://*.whitestone.top; img-src 'self' data: https://*.whitestone.top; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Biwei.Lai",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "NucleAgent desktop client",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
