{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NucleAgent",
  "version": "0.1.0",
  "identifier": "top.whitestone.nucleagent",
  "build": {
    "frontendDist": "../../dist/shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "NucleAgent",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "local-runner",
          "description": "Only the packaged runner panel can bind, start and stop the native private runner.",
          "windows": [
            "local-runner"
          ],
          "local": true,
          "permissions": [
            "allow-runner-snapshot",
            "allow-runner-install",
            "allow-runner-control"
          ]
        }
      ],
      "csp": "default-src 'self'; frame-src https://whitestone.top https://*.whitestone.top; connect-src 'self' https://whitestone.top https://*.whitestone.top wss://*.whitestone.top; img-src 'self' data: blob: https://*.whitestone.top; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "Biwei.Lai",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "NucleAgent desktop client",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "externalBin": [
      "binaries/nucleagent-runner"
    ]
  }
}
